;; Resident creature state: remember + steer (physics.stepBody) for a batch of creature rows in one call, in place, bit-identical to the JS
;; (f64 arithmetic in the same order, fdlibm sin/cos). Memory is the brain bank's (imported); rows are built by resident.ts.
;; Row (bytes): f64 x@0 y@8 vx@16 vy@24 energy@32 heading@40 turnRate@48 ticksAlive@56 cos@64 sin@72 upkeep@80 groundFactor@88; i32 outPtr@112 params@116
;;   short@120 unitCount@124 bad@140; units f64 from @192. outPtr is the byte address of the creature's brain outputs (turn, thrust, then one target per unit).
;; Call block P: i32 n@0 rows@4 (n row addresses); f64 agingStart@8 agingPerTick@16; scratch for sin/cos @32.
;; Species param block (bytes): f64 dt@0 maxTurnRate@8 kTurn@16 kDrag@24 kSide@32 drag@40 maxThrust@48 maxBrake@56 thrustCost@64 turnCost@72
;;   radius@80 wallBounce@88 width@96 height@104 brakeThreshold@112 shortRate@120 longRate@128 rockMaxR@136 invRockCell@144; i32 rockCols@172 rockRows@176
;;   rockStart@180 rockOrder@184 rockXYR@188 nearRaster@192 nearCols@196 nearRows@200 (0 when the map has no rock).
;; Rows also hold, for fill: f64 rayLength@104; i32 rays@128 offsets@132 input@136 slot@144. Species block: f64 startEnergy@208.
;; Returns how many rows had a heading too large for the sin/cos port; those are left unsteered with bad@140 = 1 for the caller to finish in JS.
(module
  (import "brain" "mem" (memory 1))
  (global $tab (mut i32) (i32.const 0))
  (func $hi (param $x f64) (result i32)
    (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (local.get $x)) (i64.const 32))))

  (func $kcos (param $x f64) (param $y f64) (result f64)
    (local $ix i32) (local $z f64) (local $r f64) (local $qx f64)
    (local.set $ix (i32.and (call $hi (local.get $x)) (i32.const 0x7fffffff)))
    (if (i32.lt_s (local.get $ix) (i32.const 0x3E400000))
      (then (if (i32.eqz (i32.trunc_f64_s (local.get $x))) (then (return (f64.const 1))))))
    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    (local.set $r
      (f64.mul (local.get $z)
        (f64.add (f64.const 4.16666666666666019037e-02)
          (f64.mul (local.get $z)
            (f64.add (f64.const -1.38888888888741095749e-03)
              (f64.mul (local.get $z)
                (f64.add (f64.const 2.48015872894767294178e-05)
                  (f64.mul (local.get $z)
                    (f64.add (f64.const -2.75573143513906633035e-07)
                      (f64.mul (local.get $z)
                        (f64.add (f64.const 2.08757232129817482790e-09)
                          (f64.mul (local.get $z) (f64.const -1.13596475577881948265e-11)))))))))))))
    (if (i32.lt_s (local.get $ix) (i32.const 0x3FD33333))
      (then
        ;; 1 - (0.5 z - (z r - x y))
        (return (f64.sub (f64.const 1)
          (f64.sub (f64.mul (f64.const 0.5) (local.get $z))
            (f64.sub (f64.mul (local.get $z) (local.get $r)) (f64.mul (local.get $x) (local.get $y))))))))
    (if (i32.gt_s (local.get $ix) (i32.const 0x3FE90000))
      (then (local.set $qx (f64.const 0.28125)))
      (else (local.set $qx (f64.reinterpret_i64 (i64.shl (i64.extend_i32_u (i32.sub (local.get $ix) (i32.const 0x00200000))) (i64.const 32))))))
    ;; (1 - qx) - ((0.5 z - qx) - (z r - x y))
    (f64.sub (f64.sub (f64.const 1) (local.get $qx))
      (f64.sub (f64.sub (f64.mul (f64.const 0.5) (local.get $z)) (local.get $qx))
        (f64.sub (f64.mul (local.get $z) (local.get $r)) (f64.mul (local.get $x) (local.get $y))))))

  (func $ksin (param $x f64) (param $y f64) (param $iy i32) (result f64)
    (local $ix i32) (local $z f64) (local $v f64) (local $r f64)
    (local.set $ix (i32.and (call $hi (local.get $x)) (i32.const 0x7fffffff)))
    (if (i32.lt_s (local.get $ix) (i32.const 0x3E400000))
      (then (if (i32.eqz (i32.trunc_f64_s (local.get $x))) (then (return (local.get $x))))))
    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    (local.set $v (f64.mul (local.get $z) (local.get $x)))
    (local.set $r
      (f64.add (f64.const 8.33333333332248946124e-03)
        (f64.mul (local.get $z)
          (f64.add (f64.const -1.98412698298579493134e-04)
            (f64.mul (local.get $z)
              (f64.add (f64.const 2.75573137070700676789e-06)
                (f64.mul (local.get $z)
                  (f64.add (f64.const -2.50507602534068634195e-08)
                    (f64.mul (local.get $z) (f64.const 1.58969099521155010221e-10))))))))))
    (if (i32.eqz (local.get $iy))
      (then
        ;; x + v (S1 + z r)
        (return (f64.add (local.get $x)
          (f64.mul (local.get $v) (f64.add (f64.const -1.66666666666666324348e-01) (f64.mul (local.get $z) (local.get $r))))))))
    ;; x - ((z (0.5 y - v r) - y) - v S1)
    (f64.sub (local.get $x)
      (f64.sub
        (f64.sub (f64.mul (local.get $z) (f64.sub (f64.mul (f64.const 0.5) (local.get $y)) (f64.mul (local.get $v) (local.get $r)))) (local.get $y))
        (f64.mul (local.get $v) (f64.const -1.66666666666666324348e-01)))))

  ;; fdlibm __ieee754_rem_pio2 for pi/4 < |x| <= 2^19 pi/2: returns n, y0, y1. n = 0x80000000 marks a larger finite |x|.
  (func $rem (param $x f64) (result i32 f64 f64)
    (local $hx i32) (local $ix i32) (local $z f64) (local $t f64) (local $n i32) (local $fn f64)
    (local $r f64) (local $w f64) (local $y0 f64) (local $y1 f64) (local $j i32) (local $i i32) (local $big i32)
    (local.set $hx (call $hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7fffffff)))
    (if (i32.lt_s (local.get $ix) (i32.const 0x4002D97C))
      (then
        (if (i32.gt_s (local.get $hx) (i32.const 0))
          (then
            (local.set $z (f64.sub (local.get $x) (f64.const 1.57079632673412561417e+00)))
            (if (i32.ne (local.get $ix) (i32.const 0x3FF921FB))
              (then
                (local.set $y0 (f64.sub (local.get $z) (f64.const 6.07710050650619224932e-11)))
                (local.set $y1 (f64.sub (f64.sub (local.get $z) (local.get $y0)) (f64.const 6.07710050650619224932e-11))))
              (else
                (local.set $z (f64.sub (local.get $z) (f64.const 6.07710050630396597660e-11)))
                (local.set $y0 (f64.sub (local.get $z) (f64.const 2.02226624879595063154e-21)))
                (local.set $y1 (f64.sub (f64.sub (local.get $z) (local.get $y0)) (f64.const 2.02226624879595063154e-21)))))
            (return (i32.const 1) (local.get $y0) (local.get $y1)))
          (else
            (local.set $z (f64.add (local.get $x) (f64.const 1.57079632673412561417e+00)))
            (if (i32.ne (local.get $ix) (i32.const 0x3FF921FB))
              (then
                (local.set $y0 (f64.add (local.get $z) (f64.const 6.07710050650619224932e-11)))
                (local.set $y1 (f64.add (f64.sub (local.get $z) (local.get $y0)) (f64.const 6.07710050650619224932e-11))))
              (else
                (local.set $z (f64.add (local.get $z) (f64.const 6.07710050630396597660e-11)))
                (local.set $y0 (f64.add (local.get $z) (f64.const 2.02226624879595063154e-21)))
                (local.set $y1 (f64.add (f64.sub (local.get $z) (local.get $y0)) (f64.const 2.02226624879595063154e-21)))))
            (return (i32.const -1) (local.get $y0) (local.get $y1))))))
    (if (i32.gt_s (local.get $ix) (i32.const 0x413921FB))
      (then (return (i32.const 0x80000000) (f64.const 0) (f64.const 0))))
    ;; medium size
    (local.set $t (f64.abs (local.get $x)))
    (local.set $n (i32.trunc_f64_s (f64.add (f64.mul (local.get $t) (f64.const 6.36619772367581382433e-01)) (f64.const 0.5))))
    (local.set $fn (f64.convert_i32_s (local.get $n)))
    (local.set $r (f64.sub (local.get $t) (f64.mul (local.get $fn) (f64.const 1.57079632673412561417e+00))))
    (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050650619224932e-11)))
    ;; quick check: n < 32 and ix differs from the high word of n pi/2
    (local.set $big
      (if (result i32) (i32.lt_s (local.get $n) (i32.const 32))
        (then (i32.ne (local.get $ix) (i32.load (i32.add (i32.sub (global.get $tab) (i32.const 4)) (i32.shl (local.get $n) (i32.const 2))))))
        (else (i32.const 0))))
    (if (local.get $big)
      (then (local.set $y0 (f64.sub (local.get $r) (local.get $w))))
      (else
        (local.set $j (i32.shr_s (local.get $ix) (i32.const 20)))
        (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
        (local.set $i (i32.sub (local.get $j) (i32.and (i32.shr_u (call $hi (local.get $y0)) (i32.const 20)) (i32.const 0x7ff))))
        (if (i32.gt_s (local.get $i) (i32.const 16))
          (then
            (local.set $t (local.get $r))
            (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050630396597660e-11)))
            (local.set $r (f64.sub (local.get $t) (local.get $w)))
            (local.set $w (f64.sub (f64.mul (local.get $fn) (f64.const 2.02226624879595063154e-21))
                                   (f64.sub (f64.sub (local.get $t) (local.get $r)) (local.get $w))))
            (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
            (local.set $i (i32.sub (local.get $j) (i32.and (i32.shr_u (call $hi (local.get $y0)) (i32.const 20)) (i32.const 0x7ff))))
            (if (i32.gt_s (local.get $i) (i32.const 49))
              (then
                (local.set $t (local.get $r))
                (local.set $w (f64.mul (local.get $fn) (f64.const 2.02226624871116645580e-21)))
                (local.set $r (f64.sub (local.get $t) (local.get $w)))
                (local.set $w (f64.sub (f64.mul (local.get $fn) (f64.const 8.47842766036889956997e-32))
                                       (f64.sub (f64.sub (local.get $t) (local.get $r)) (local.get $w))))
                (local.set $y0 (f64.sub (local.get $r) (local.get $w)))))))))
    (local.set $y1 (f64.sub (f64.sub (local.get $r) (local.get $y0)) (local.get $w)))
    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then (return (i32.sub (i32.const 0) (local.get $n)) (f64.neg (local.get $y0)) (f64.neg (local.get $y1)))))
    (local.get $n) (local.get $y0) (local.get $y1))

  ;; Writes sin x at byte $o and cos x at $o + 8. Returns 1 (nothing written) when |x| is too large for this port.
  (func $sc (param $x f64) (param $o i32) (result i32)
    (local $ix i32) (local $n i32) (local $y0 f64) (local $y1 f64) (local $s f64) (local $c f64) (local $nan f64)
    (local.set $ix (i32.and (call $hi (local.get $x)) (i32.const 0x7fffffff)))
    (if (i32.le_s (local.get $ix) (i32.const 0x3FE921FB))
      (then
        (f64.store (local.get $o) (call $ksin (local.get $x) (f64.const 0) (i32.const 0)))
        (f64.store (i32.add (local.get $o) (i32.const 8)) (call $kcos (local.get $x) (f64.const 0)))
        (return (i32.const 0))))
    (if (i32.ge_s (local.get $ix) (i32.const 0x7FF00000))
      (then
        (local.set $nan (f64.sub (local.get $x) (local.get $x)))
        (f64.store (local.get $o) (local.get $nan))
        (f64.store (i32.add (local.get $o) (i32.const 8)) (local.get $nan))
        (return (i32.const 0))))
    (call $rem (local.get $x))
    (local.set $y1) (local.set $y0) (local.set $n)
    (if (i32.eq (local.get $n) (i32.const 0x80000000)) (then (return (i32.const 1))))
    (local.set $s (call $ksin (local.get $y0) (local.get $y1) (i32.const 1)))
    (local.set $c (call $kcos (local.get $y0) (local.get $y1)))
    ;; n&3: 0 -> (s, c), 1 -> (c, -s), 2 -> (-s, -c), 3 -> (-c, s)
    (block $done
      (block $three (block $two (block $one
        (br_table $done $one $two $three (i32.and (local.get $n) (i32.const 3))))
        ;; 1
        (f64.store (local.get $o) (local.get $c))
        (f64.store (i32.add (local.get $o) (i32.const 8)) (f64.neg (local.get $s)))
        (return (i32.const 0)))
        ;; 2
        (f64.store (local.get $o) (f64.neg (local.get $s)))
        (f64.store (i32.add (local.get $o) (i32.const 8)) (f64.neg (local.get $c)))
        (return (i32.const 0)))
        ;; 3
        (f64.store (local.get $o) (f64.neg (local.get $c)))
        (f64.store (i32.add (local.get $o) (i32.const 8)) (local.get $s))
        (return (i32.const 0)))
    ;; 0
    (f64.store (local.get $o) (local.get $s))
    (f64.store (i32.add (local.get $o) (i32.const 8)) (local.get $c))
    (i32.const 0))

  ;; fdlibm exp as in V8 (base::ieee754::exp), for the energy signal 1 - exp(-energy / startEnergy)
  (func $exp (param $x f64) (result f64)
    (local $hx i32) (local $xsb i32) (local $k i32) (local $hi f64) (local $lo f64) (local $t f64) (local $c f64) (local $y f64) (local $twopk f64)
    (local.set $hx (call $hi (local.get $x)))
    (local.set $xsb (i32.and (i32.shr_u (local.get $hx) (i32.const 31)) (i32.const 1)))
    (local.set $hx (i32.and (local.get $hx) (i32.const 0x7fffffff)))
    (if (i32.ge_u (local.get $hx) (i32.const 0x40862E42))
      (then
        (if (i32.ge_u (local.get $hx) (i32.const 0x7ff00000))
          (then
            (if (i32.or (i32.and (local.get $hx) (i32.const 0xfffff)) (i32.wrap_i64 (i64.reinterpret_f64 (local.get $x))))
              (then (return (f64.add (local.get $x) (local.get $x)))))
            (return (select (f64.const 0) (local.get $x) (local.get $xsb)))))
        (if (f64.gt (local.get $x) (f64.const 7.09782712893383973096e+02)) (then (return (f64.const inf))))
        (if (f64.lt (local.get $x) (f64.const -7.45133219101941108420e+02)) (then (return (f64.const 0))))))
    (if (i32.gt_u (local.get $hx) (i32.const 0x3fd62e42))
      (then
        (if (i32.lt_u (local.get $hx) (i32.const 0x3FF0A2B2))
          (then
            (if (f64.eq (local.get $x) (f64.const 1)) (then (return (f64.const 2.718281828459045))))
            (local.set $hi (f64.sub (local.get $x) (select (f64.const -6.93147180369123816490e-01) (f64.const 6.93147180369123816490e-01) (local.get $xsb))))
            (local.set $lo (select (f64.const -1.90821492927058770002e-10) (f64.const 1.90821492927058770002e-10) (local.get $xsb)))
            (local.set $k (i32.sub (i32.sub (i32.const 1) (local.get $xsb)) (local.get $xsb))))
          (else
            (local.set $k (i32.trunc_f64_s (f64.add (f64.mul (f64.const 1.44269504088896338700e+00) (local.get $x)) (select (f64.const -0.5) (f64.const 0.5) (local.get $xsb)))))
            (local.set $t (f64.convert_i32_s (local.get $k)))
            (local.set $hi (f64.sub (local.get $x) (f64.mul (local.get $t) (f64.const 6.93147180369123816490e-01))))
            (local.set $lo (f64.mul (local.get $t) (f64.const 1.90821492927058770002e-10)))))
        (local.set $x (f64.sub (local.get $hi) (local.get $lo))))
      (else
        (if (i32.lt_u (local.get $hx) (i32.const 0x3e300000))
          (then (return (f64.add (f64.const 1) (local.get $x)))))))
    (local.set $t (f64.mul (local.get $x) (local.get $x)))
    (local.set $twopk (f64.reinterpret_i64 (i64.shl (i64.extend_i32_u
      (i32.add (i32.const 0x3ff00000) (i32.shl (select (local.get $k) (i32.add (local.get $k) (i32.const 1000)) (i32.ge_s (local.get $k) (i32.const -1021))) (i32.const 20)))) (i64.const 32))))
    (local.set $c (f64.sub (local.get $x)
      (f64.mul (local.get $t)
        (f64.add (f64.const 1.66666666666666019037e-01)
          (f64.mul (local.get $t)
            (f64.add (f64.const -2.77777777770155933842e-03)
              (f64.mul (local.get $t)
                (f64.add (f64.const 6.61375632143793436117e-05)
                  (f64.mul (local.get $t)
                    (f64.add (f64.const -1.65339022054652515390e-06)
                      (f64.mul (local.get $t) (f64.const 4.13813679705723846039e-08))))))))))))
    (if (i32.eqz (local.get $k))
      (then (return (f64.sub (f64.const 1) (f64.sub (f64.div (f64.mul (local.get $x) (local.get $c)) (f64.sub (local.get $c) (f64.const 2))) (local.get $x))))))
    (local.set $y (f64.sub (f64.const 1) (f64.sub (f64.sub (local.get $lo) (f64.div (f64.mul (local.get $x) (local.get $c)) (f64.sub (f64.const 2) (local.get $c)))) (local.get $hi))))
    (if (i32.ge_s (local.get $k) (i32.const -1021))
      (then
        (if (i32.eq (local.get $k) (i32.const 1024))
          (then (return (f64.mul (f64.mul (local.get $y) (f64.const 2)) (f64.const 0x1p+1023)))))
        (return (f64.mul (local.get $y) (local.get $twopk)))))
    (f64.mul (f64.mul (local.get $y) (local.get $twopk)) (f64.const 9.33263618503218878990e-302)))

  ;; GroundField.valueAt: -1 on mud, 1 on firm ground, 0 elsewhere. F: i32 data@56 cols@60 rows@64, f64 inv@72
  (func $ground (param $F i32) (param $x f64) (param $y f64) (result f64)
    (local $cols i32) (local $fx f64) (local $fy f64) (local $i i32) (local $j i32) (local $k i32) (local $row i32) (local $g i32)
    (local $tx f64) (local $ty f64) (local $a f64) (local $b f64) (local $c f64) (local $d f64)
    (local.set $cols (i32.load offset=60 (local.get $F)))
    (local.set $fx (f64.min (f64.sub (f64.convert_i32_s (local.get $cols)) (f64.const 1.0001)) (f64.max (f64.const 0) (f64.add (f64.mul (local.get $x) (f64.load offset=72 (local.get $F))) (f64.const 1)))))
    (local.set $fy (f64.min (f64.sub (f64.convert_i32_s (i32.load offset=64 (local.get $F))) (f64.const 1.0001)) (f64.max (f64.const 0) (f64.add (f64.mul (local.get $y) (f64.load offset=72 (local.get $F))) (f64.const 1)))))
    (local.set $i (i32.trunc_sat_f64_s (local.get $fx)))
    (local.set $j (i32.trunc_sat_f64_s (local.get $fy)))
    (local.set $k (i32.shl (i32.add (i32.mul (local.get $j) (local.get $cols)) (local.get $i)) (i32.const 1)))
    (local.set $row (i32.add (local.get $k) (i32.shl (local.get $cols) (i32.const 1))))
    (local.set $g (i32.load offset=56 (local.get $F)))
    (local.set $tx (f64.sub (local.get $fx) (f64.convert_i32_s (local.get $i))))
    (local.set $ty (f64.sub (local.get $fy) (f64.convert_i32_s (local.get $j))))
    (local.set $a (f64.convert_i32_u (i32.load8_u (i32.add (local.get $g) (local.get $k)))))
    (local.set $b (f64.convert_i32_u (i32.load8_u offset=2 (i32.add (local.get $g) (local.get $k)))))
    (local.set $c (f64.convert_i32_u (i32.load8_u (i32.add (local.get $g) (local.get $row)))))
    (local.set $d (f64.convert_i32_u (i32.load8_u offset=2 (i32.add (local.get $g) (local.get $row)))))
    (if (i32.and
          (i32.or (i32.or (f64.ge (local.get $a) (f64.const 128)) (f64.ge (local.get $b) (f64.const 128))) (i32.or (f64.ge (local.get $c) (f64.const 128)) (f64.ge (local.get $d) (f64.const 128))))
          (f64.ge (f64.add (f64.add (f64.add (local.get $a) (f64.mul (f64.sub (local.get $b) (local.get $a)) (local.get $tx))) (f64.mul (f64.sub (local.get $c) (local.get $a)) (local.get $ty)))
                           (f64.mul (f64.mul (f64.add (f64.sub (f64.sub (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (local.get $tx)) (local.get $ty))) (f64.const 127.5)))
      (then (return (f64.const -1))))
    (local.set $a (f64.convert_i32_u (i32.load8_u offset=1 (i32.add (local.get $g) (local.get $k)))))
    (local.set $b (f64.convert_i32_u (i32.load8_u offset=3 (i32.add (local.get $g) (local.get $k)))))
    (local.set $c (f64.convert_i32_u (i32.load8_u offset=1 (i32.add (local.get $g) (local.get $row)))))
    (local.set $d (f64.convert_i32_u (i32.load8_u offset=3 (i32.add (local.get $g) (local.get $row)))))
    (if (i32.and
          (i32.or (i32.or (f64.ge (local.get $a) (f64.const 128)) (f64.ge (local.get $b) (f64.const 128))) (i32.or (f64.ge (local.get $c) (f64.const 128)) (f64.ge (local.get $d) (f64.const 128))))
          (f64.ge (f64.add (f64.add (f64.add (local.get $a) (f64.mul (f64.sub (local.get $b) (local.get $a)) (local.get $tx))) (f64.mul (f64.sub (local.get $c) (local.get $a)) (local.get $ty)))
                           (f64.mul (f64.mul (f64.add (f64.sub (f64.sub (local.get $a) (local.get $b)) (local.get $c)) (local.get $d)) (local.get $tx)) (local.get $ty))) (f64.const 127.5)))
      (then (return (f64.const 1))))
    (f64.const 0))

  ;; The sense records and body inputs of a batch from the resident rows (what WasmSenser.run's per-creature loop did in JS):
  ;; creatures counting-sorted by item grid row into 64-byte records at F.rec, and each one's body inputs (energy signal, speeds, turn, ground, units)
  ;; written into its brain input vector. Also writes each row's ground factor (for the step) and the brain slot list of the batch.
  ;; Call block F (bytes): i32 n@0 rows@4 selves@8 rec@12 place@16 rowCount@20 slots@24 detailPtr@28 detailRow@32 stride@36 itemRows@40 groundData@56 groundCols@60 groundRows@64
  ;;   f64 invCell@48 groundInv@72 slowFactor@80 fastFactor@88.
  ;; Rows (more): i32 rays@128 offsets@132 input@136 slot@144; f64 rayLength@104.
  (func (export "fill") (param $F i32)
    (local $n i32) (local $k i32) (local $rows i32) (local $place i32) (local $count i32) (local $nrows i32) (local $r i32) (local $row i32) (local $q i32) (local $rec i32)
    (local $v f64) (local $x f64) (local $y f64) (local $cos f64) (local $sin f64) (local $vx f64) (local $vy f64) (local $Q i32) (local $at i32) (local $nR i32) (local $in i32)
    (local $g f64) (local $units i32) (local $u i32) (local $detailRow i32) (local $drag f64) (local $maxThrust f64) (local $inv f64)
    (local.set $n (i32.load (local.get $F)))
    (local.set $rows (i32.load offset=4 (local.get $F)))
    (local.set $place (i32.load offset=16 (local.get $F)))
    (local.set $count (i32.load offset=20 (local.get $F)))
    (local.set $nrows (i32.load offset=40 (local.get $F)))
    (local.set $inv (f64.load offset=48 (local.get $F)))
    (local.set $detailRow (i32.load offset=32 (local.get $F)))
    ;; counts per item grid row (counting sort, stable): count[row + 1]++
    (local.set $r (i32.const 0))
    (block $zd (loop $zl
      (br_if $zd (i32.gt_s (local.get $r) (local.get $nrows)))
      (i32.store (i32.add (local.get $count) (i32.shl (local.get $r) (i32.const 2))) (i32.const 0))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $zl)))
    (block $cd (loop $cl
      (br_if $cd (i32.ge_s (local.get $k) (local.get $n)))
      (local.set $row (i32.load (i32.add (local.get $rows) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $v (f64.floor (f64.mul (f64.load offset=8 (local.get $row)) (local.get $inv))))
      ;; NaN and negative go to row 0
      (local.set $r (select
        (select (i32.sub (local.get $nrows) (i32.const 1)) (i32.trunc_sat_f64_s (local.get $v)) (f64.ge (local.get $v) (f64.convert_i32_s (local.get $nrows))))
        (i32.const 0)
        (f64.ge (local.get $v) (f64.const 0))))
      (i32.store (i32.add (local.get $place) (i32.shl (local.get $k) (i32.const 2))) (local.get $r))
      (local.set $r (i32.add (i32.shl (i32.add (local.get $r) (i32.const 1)) (i32.const 2)) (local.get $count)))
      (i32.store (local.get $r) (i32.add (i32.load (local.get $r)) (i32.const 1)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $cl)))
    (local.set $r (i32.const 0))
    (block $pd (loop $pl
      (br_if $pd (i32.ge_s (local.get $r) (local.get $nrows)))
      (i32.store offset=4 (i32.add (local.get $count) (i32.shl (local.get $r) (i32.const 2)))
        (i32.add (i32.load offset=4 (i32.add (local.get $count) (i32.shl (local.get $r) (i32.const 2))))
                 (i32.load (i32.add (local.get $count) (i32.shl (local.get $r) (i32.const 2))))))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $pl)))
    (local.set $k (i32.const 0))
    (block $fd (loop $fl
      (br_if $fd (i32.ge_s (local.get $k) (local.get $n)))
      (local.set $row (i32.load (i32.add (local.get $rows) (i32.shl (local.get $k) (i32.const 2)))))
      ;; q = count[row index]++, the record position
      (local.set $at (i32.add (local.get $count) (i32.shl (i32.load (i32.add (local.get $place) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2))))
      (local.set $q (i32.load (local.get $at)))
      (i32.store (local.get $at) (i32.add (local.get $q) (i32.const 1)))
      (local.set $rec (i32.add (i32.load offset=12 (local.get $F)) (i32.shl (local.get $q) (i32.const 6))))
      (local.set $x (f64.load (local.get $row)))
      (local.set $y (f64.load offset=8 (local.get $row)))
      (local.set $cos (f64.load offset=64 (local.get $row)))
      (local.set $sin (f64.load offset=72 (local.get $row)))
      (local.set $nR (i32.load offset=128 (local.get $row)))
      (f64.store (local.get $rec) (local.get $x))
      (f64.store offset=8 (local.get $rec) (local.get $y))
      (f64.store offset=16 (local.get $rec) (local.get $cos))
      (f64.store offset=24 (local.get $rec) (local.get $sin))
      (f64.store offset=32 (local.get $rec) (f64.load offset=104 (local.get $row)))
      (i32.store offset=40 (local.get $rec) (i32.load (i32.add (i32.load offset=8 (local.get $F)) (i32.shl (local.get $k) (i32.const 2)))))
      (i32.store offset=44 (local.get $rec) (local.get $nR))
      (i32.store offset=48 (local.get $rec) (i32.load offset=132 (local.get $row)))
      (local.set $in (i32.load offset=136 (local.get $row)))
      (i32.store offset=52 (local.get $rec) (local.get $in))
      (i32.store offset=56 (local.get $rec) (select (i32.load offset=28 (local.get $F)) (i32.const 0) (i32.eq (local.get $row) (local.get $detailRow))))
      (i32.store (i32.add (i32.load offset=24 (local.get $F)) (i32.shl (local.get $k) (i32.const 2))) (i32.load offset=144 (local.get $row)))
      ;; body inputs at input + 4 * rays * stride
      (local.set $Q (i32.load offset=116 (local.get $row)))
      (local.set $drag (f64.load offset=40 (local.get $Q)))
      (local.set $maxThrust (f64.load offset=48 (local.get $Q)))
      (local.set $vx (f64.load offset=16 (local.get $row)))
      (local.set $vy (f64.load offset=24 (local.get $row)))
      (local.set $at (i32.add (local.get $in) (i32.shl (i32.mul (local.get $nR) (i32.load offset=36 (local.get $F))) (i32.const 2))))
      ;; energySignal: 1 - exp(-energy / startEnergy)
      (f32.store (local.get $at)
        (f32.demote_f64 (f64.sub (f64.const 1) (call $exp (f64.div (f64.neg (f64.load offset=32 (local.get $row))) (f64.load offset=208 (local.get $Q)))))))
      (f32.store offset=4 (local.get $at)
        (f32.demote_f64 (f64.div (f64.mul (f64.add (f64.mul (local.get $vx) (local.get $cos)) (f64.mul (local.get $vy) (local.get $sin))) (local.get $drag)) (local.get $maxThrust))))
      (f32.store offset=8 (local.get $at)
        (f32.demote_f64 (f64.div (f64.mul (f64.sub (f64.mul (local.get $vy) (local.get $cos)) (f64.mul (local.get $vx) (local.get $sin))) (local.get $drag)) (local.get $maxThrust))))
      (f32.store offset=12 (local.get $at)
        (f32.demote_f64 (f64.div (f64.load offset=48 (local.get $row)) (f64.load offset=8 (local.get $Q)))))
      (local.set $g (f64.const 0))
      (if (i32.ne (i32.load offset=56 (local.get $F)) (i32.const 0))
        (then
          (local.set $g (call $ground (local.get $F) (local.get $x) (local.get $y)))
          (f64.store offset=88 (local.get $row)
            (select (f64.load offset=80 (local.get $F)) (select (f64.load offset=88 (local.get $F)) (f64.const 1) (f64.gt (local.get $g) (f64.const 0))) (f64.lt (local.get $g) (f64.const 0))))))
      (f32.store offset=16 (local.get $at) (f32.demote_f64 (local.get $g)))
      ;; memory units
      (local.set $u (i32.const 0))
      (local.set $units (i32.load offset=124 (local.get $row)))
      (block $ud (loop $ul
        (br_if $ud (i32.ge_s (local.get $u) (local.get $units)))
        (f32.store offset=20 (i32.add (local.get $at) (i32.shl (local.get $u) (i32.const 2)))
          (f32.demote_f64 (f64.load offset=192 (i32.add (local.get $row) (i32.shl (local.get $u) (i32.const 3))))))
        (local.set $u (i32.add (local.get $u) (i32.const 1)))
        (br $ul)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $fl))))

  (func $keepOut (param $P i32) (param $rec i32)
    (local $pass i32) (local $moved i32) (local $e f64) (local $inv f64) (local $x f64) (local $y f64)
    (local $cx0 i32) (local $cx1 i32) (local $cy0 i32) (local $cy1 i32) (local $cy i32) (local $k i32) (local $end i32) (local $i i32)
    (local $reach f64) (local $nx f64) (local $ny f64) (local $d2 f64) (local $d f64) (local $r f64) (local $into f64) (local $disc i32)
    (local $fx f64) (local $fy f64) (local $cols i32) (local $radius f64) (local $rest f64) (local $vx f64) (local $vy f64) (local $rs i32) (local $ro i32)
    (local.set $cols (i32.load offset=172 (local.get $P)))
    (if (i32.eqz (local.get $cols)) (then (return)))
    ;; early out: the clear-of-rock raster (terrain.ts keepOut), one byte per 100 unit square, 0 where no disc can reach
    (if (i32.ne (i32.load offset=192 (local.get $P)) (i32.const 0))
      (then
        (local.set $fx (f64.floor (f64.div (f64.load (local.get $rec)) (f64.const 100))))
        (local.set $fy (f64.floor (f64.div (f64.load offset=8 (local.get $rec)) (f64.const 100))))
        (if (i32.and
              (i32.and (f64.ge (local.get $fx) (f64.const 0)) (f64.lt (local.get $fx) (f64.convert_i32_s (i32.load offset=196 (local.get $P)))))
              (i32.and (f64.ge (local.get $fy) (f64.const 0)) (f64.lt (local.get $fy) (f64.convert_i32_s (i32.load offset=200 (local.get $P))))))
          (then
            (if (i32.eqz (i32.load8_u (i32.add (i32.load offset=192 (local.get $P))
                  (i32.add (i32.mul (i32.trunc_f64_s (local.get $fy)) (i32.load offset=196 (local.get $P))) (i32.trunc_f64_s (local.get $fx))))))
              (then (return)))))))
    (local.set $rs (i32.load offset=180 (local.get $P)))
    (local.set $ro (i32.load offset=184 (local.get $P)))
    (local.set $radius (f64.load offset=80 (local.get $P)))
    (local.set $rest (f64.load offset=88 (local.get $P)))
    (local.set $inv (f64.load offset=144 (local.get $P)))
    (local.set $e (f64.add (local.get $radius) (f64.load offset=136 (local.get $P))))
    (block $out (loop $again
      (br_if $out (i32.ge_u (local.get $pass) (i32.const 4)))
      (local.set $moved (i32.const 0))
      (local.set $x (f64.load (local.get $rec)))
      (local.set $y (f64.load offset=8 (local.get $rec)))
      (local.set $cx0 (i32.trunc_sat_f64_s (f64.max (f64.const 0) (f64.floor (f64.mul (f64.sub (local.get $x) (local.get $e)) (local.get $inv))))))
      (local.set $cx1 (i32.trunc_sat_f64_s (f64.min (f64.convert_i32_s (i32.sub (local.get $cols) (i32.const 1))) (f64.floor (f64.mul (f64.add (local.get $x) (local.get $e)) (local.get $inv))))))
      (local.set $cy0 (i32.trunc_sat_f64_s (f64.max (f64.const 0) (f64.floor (f64.mul (f64.sub (local.get $y) (local.get $e)) (local.get $inv))))))
      (local.set $cy1 (i32.trunc_sat_f64_s (f64.min (f64.convert_i32_s (i32.sub (i32.load offset=176 (local.get $P)) (i32.const 1))) (f64.floor (f64.mul (f64.add (local.get $y) (local.get $e)) (local.get $inv))))))
      (local.set $cy (local.get $cy0))
      (block $rowsDone (loop $rows
        (br_if $rowsDone (i32.gt_s (local.get $cy) (local.get $cy1)))
        (local.set $k (i32.load (i32.add (local.get $rs) (i32.shl (i32.add (i32.mul (local.get $cy) (local.get $cols)) (local.get $cx0)) (i32.const 2)))))
        (local.set $end (i32.load (i32.add (local.get $rs) (i32.shl (i32.add (i32.add (i32.mul (local.get $cy) (local.get $cols)) (local.get $cx1)) (i32.const 1)) (i32.const 2)))))
        (block $cellsDone (loop $cells
          (br_if $cellsDone (i32.ge_s (local.get $k) (local.get $end)))
          (local.set $i (i32.load (i32.add (local.get $ro) (i32.shl (local.get $k) (i32.const 2)))))
          (local.set $disc (i32.add (i32.load offset=188 (local.get $P)) (i32.mul (local.get $i) (i32.const 24))))
          (local.set $r (f64.load offset=16 (local.get $disc)))
          (local.set $reach (f64.add (local.get $r) (local.get $radius)))
          (local.set $x (f64.load (local.get $rec)))
          (local.set $y (f64.load offset=8 (local.get $rec)))
          (local.set $nx (f64.sub (local.get $x) (f64.load (local.get $disc))))
          (local.set $ny (f64.sub (local.get $y) (f64.load offset=8 (local.get $disc))))
          (local.set $d2 (f64.add (f64.mul (local.get $nx) (local.get $nx)) (f64.mul (local.get $ny) (local.get $ny))))
          (if (i32.eqz (f64.ge (local.get $d2) (f64.mul (local.get $reach) (local.get $reach))))
            (then
              (local.set $d (f64.sqrt (local.get $d2)))
              (if (f64.gt (local.get $d) (f64.const 0))
                (then (local.set $nx (f64.div (local.get $nx) (local.get $d))) (local.set $ny (f64.div (local.get $ny) (local.get $d))))
                (else (local.set $nx (f64.const 1)) (local.set $ny (f64.const 0))))
              (f64.store (local.get $rec) (f64.add (f64.load (local.get $disc)) (f64.mul (local.get $nx) (local.get $reach))))
              (f64.store offset=8 (local.get $rec) (f64.add (f64.load offset=8 (local.get $disc)) (f64.mul (local.get $ny) (local.get $reach))))
              (local.set $vx (f64.load offset=16 (local.get $rec)))
              (local.set $vy (f64.load offset=24 (local.get $rec)))
              (local.set $into (f64.add (f64.mul (local.get $vx) (local.get $nx)) (f64.mul (local.get $vy) (local.get $ny))))
              (if (f64.lt (local.get $into) (f64.const 0))
                (then
                  (f64.store offset=16 (local.get $rec) (f64.sub (local.get $vx) (f64.mul (f64.mul (f64.add (f64.const 1) (local.get $rest)) (local.get $into)) (local.get $nx))))
                  (f64.store offset=24 (local.get $rec) (f64.sub (local.get $vy) (f64.mul (f64.mul (f64.add (f64.const 1) (local.get $rest)) (local.get $into)) (local.get $ny))))))
              (local.set $moved (i32.const 1))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $cells)))
        (local.set $cy (i32.add (local.get $cy) (i32.const 1)))
        (br $rows)))
      (br_if $out (i32.eqz (local.get $moved)))
      (local.set $pass (i32.add (local.get $pass) (i32.const 1)))
      (br $again))))

  (func $keepInside (param $P i32) (param $rec i32)
    (local $r f64) (local $w f64) (local $h f64) (local $e f64) (local $x f64) (local $y f64) (local $v f64)
    (local.set $r (f64.load offset=80 (local.get $P)))
    (local.set $e (f64.load offset=88 (local.get $P)))
    (local.set $w (f64.load offset=96 (local.get $P)))
    (local.set $h (f64.load offset=104 (local.get $P)))
    (local.set $x (f64.load (local.get $rec)))
    (local.set $v (f64.load offset=16 (local.get $rec)))
    (if (f64.lt (local.get $x) (local.get $r))
      (then
        (f64.store (local.get $rec) (local.get $r))
        (if (f64.lt (local.get $v) (f64.const 0)) (then (f64.store offset=16 (local.get $rec) (f64.mul (f64.neg (local.get $e)) (local.get $v))))))
      (else
        (if (f64.gt (local.get $x) (f64.sub (local.get $w) (local.get $r)))
          (then
            (f64.store (local.get $rec) (f64.sub (local.get $w) (local.get $r)))
            (if (f64.gt (local.get $v) (f64.const 0)) (then (f64.store offset=16 (local.get $rec) (f64.mul (f64.neg (local.get $e)) (local.get $v)))))))))
    (local.set $y (f64.load offset=8 (local.get $rec)))
    (local.set $v (f64.load offset=24 (local.get $rec)))
    (if (f64.lt (local.get $y) (local.get $r))
      (then
        (f64.store offset=8 (local.get $rec) (local.get $r))
        (if (f64.lt (local.get $v) (f64.const 0)) (then (f64.store offset=24 (local.get $rec) (f64.mul (f64.neg (local.get $e)) (local.get $v))))))
      (else
        (if (f64.gt (local.get $y) (f64.sub (local.get $h) (local.get $r)))
          (then
            (f64.store offset=8 (local.get $rec) (f64.sub (local.get $h) (local.get $r)))
            (if (f64.gt (local.get $v) (f64.const 0)) (then (f64.store offset=24 (local.get $rec) (f64.mul (f64.neg (local.get $e)) (local.get $v))))))))))


  (func (export "setTab") (param $t i32) (global.set $tab (local.get $t)))

  ;; for the start-up probe against the engine's Math: sin x at byte $o and cos x at $o + 8 (returns 1 when x is out of the port's range), and exp x
  (func (export "sincos") (param $x f64) (param $o i32) (result i32) (call $sc (local.get $x) (local.get $o)))
  (func (export "expf") (param $x f64) (result f64) (call $exp (local.get $x)))

  (func (export "step") (param $P i32) (result i32)
    (local $Q i32) (local $n i32) (local $k i32) (local $rows i32) (local $rec i32) (local $bad i32)
    (local $out i32) (local $short i32) (local $cnt i32) (local $i i32) (local $at i32) (local $sc i32)
    (local $turnOut f64) (local $thrust f64) (local $dt f64) (local $maxTurn f64) (local $target f64) (local $turnRate f64) (local $heading f64)
    (local $cos f64) (local $sin f64) (local $vx f64) (local $vy f64) (local $v f64) (local $fwd f64) (local $terminal f64) (local $slowed f64) (local $side f64)
    (local $drag f64) (local $ground f64) (local $o f64) (local $bt f64) (local $upkeep f64) (local $ticks f64) (local $start f64)
    (local.set $n (i32.load (local.get $P)))
    (local.set $rows (i32.load offset=4 (local.get $P)))
    (local.set $sc (i32.add (local.get $P) (i32.const 32)))
    (local.set $start (f64.load offset=8 (local.get $P)))
    (block $end (loop $next
      (br_if $end (i32.ge_s (local.get $k) (local.get $n)))
      (local.set $rec (i32.load (i32.add (local.get $rows) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $Q (i32.load offset=116 (local.get $rec)))
      (local.set $dt (f64.load (local.get $Q)))
      (local.set $maxTurn (f64.load offset=8 (local.get $Q)))
      (local.set $drag (f64.load offset=40 (local.get $Q)))
      (local.set $bt (f64.load offset=112 (local.get $Q)))
      (local.set $out (i32.load offset=112 (local.get $rec)))
      (local.set $short (i32.load offset=120 (local.get $rec)))
      (local.set $cnt (i32.load offset=124 (local.get $rec)))
      ;; remember: units[i] += rate * (output[2 + i] - units[i])
      (local.set $i (i32.const 0))
      (block $mdone (loop $m
        (br_if $mdone (i32.ge_s (local.get $i) (local.get $cnt)))
        (local.set $at (i32.add (local.get $rec) (i32.add (i32.const 192) (i32.shl (local.get $i) (i32.const 3)))))
        (local.set $o (f64.promote_f32 (f32.load offset=8 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 2))))))
        (f64.store (local.get $at)
          (f64.add (f64.load (local.get $at))
            (f64.mul (select (f64.load offset=120 (local.get $Q)) (f64.load offset=128 (local.get $Q)) (i32.lt_s (local.get $i) (local.get $short)))
                     (f64.sub (local.get $o) (f64.load (local.get $at))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $m)))
      ;; steer: stepBody
      (local.set $turnOut (f64.promote_f32 (f32.load (local.get $out))))
      (local.set $thrust (f64.promote_f32 (f32.load offset=4 (local.get $out))))
      (local.set $thrust (if (result f64) (f64.lt (local.get $thrust) (local.get $bt)) (then (f64.const -1)) (else (f64.max (f64.const 0) (local.get $thrust)))))
      (local.set $target (f64.mul (local.get $turnOut) (local.get $maxTurn)))
      (local.set $turnRate (f64.add (local.get $target) (f64.mul (f64.sub (f64.load offset=48 (local.get $rec)) (local.get $target)) (f64.load offset=16 (local.get $Q)))))
      (local.set $heading (f64.add (f64.load offset=40 (local.get $rec)) (f64.mul (local.get $turnRate) (local.get $dt))))
      (if (call $sc (local.get $heading) (local.get $sc))
        (then
          ;; heading beyond the sin/cos port: leave the body untouched for the JS steer
          (i32.store offset=140 (local.get $rec) (i32.const 1))
          (local.set $bad (i32.add (local.get $bad) (i32.const 1))))
        (else
          (f64.store offset=48 (local.get $rec) (local.get $turnRate))
          (f64.store offset=40 (local.get $rec) (local.get $heading))
          (local.set $sin (f64.load (local.get $sc)))
          (local.set $cos (f64.load offset=8 (local.get $sc)))
          (f64.store offset=64 (local.get $rec) (local.get $cos))
          (f64.store offset=72 (local.get $rec) (local.get $sin))
          (local.set $vx (f64.load offset=16 (local.get $rec)))
          (local.set $vy (f64.load offset=24 (local.get $rec)))
          (local.set $v (f64.add (f64.mul (local.get $vx) (local.get $cos)) (f64.mul (local.get $vy) (local.get $sin))))
          (if (f64.ge (local.get $thrust) (f64.const 0))
            (then
              (local.set $terminal (f64.div (f64.mul (local.get $thrust) (f64.load offset=48 (local.get $Q))) (local.get $drag)))
              (local.set $fwd (f64.add (local.get $terminal) (f64.mul (f64.sub (local.get $v) (local.get $terminal)) (f64.load offset=24 (local.get $Q))))))
            (else
              (local.set $slowed (f64.add (f64.mul (f64.abs (local.get $v)) (f64.load offset=24 (local.get $Q)))
                                          (f64.mul (f64.mul (local.get $thrust) (f64.load offset=56 (local.get $Q))) (local.get $dt))))
              (local.set $fwd (if (result f64) (f64.gt (local.get $slowed) (f64.const 0))
                (then (if (result f64) (f64.lt (local.get $v) (f64.const 0)) (then (f64.neg (local.get $slowed))) (else (local.get $slowed))))
                (else (f64.const 0))))))
          (local.set $side (f64.mul (f64.add (f64.mul (f64.neg (local.get $vx)) (local.get $sin)) (f64.mul (local.get $vy) (local.get $cos))) (f64.load offset=32 (local.get $Q))))
          (local.set $vx (f64.sub (f64.mul (local.get $fwd) (local.get $cos)) (f64.mul (local.get $side) (local.get $sin))))
          (local.set $vy (f64.add (f64.mul (local.get $fwd) (local.get $sin)) (f64.mul (local.get $side) (local.get $cos))))
          (f64.store offset=16 (local.get $rec) (local.get $vx))
          (f64.store offset=24 (local.get $rec) (local.get $vy))
          (local.set $ground (f64.load offset=88 (local.get $rec)))
          (f64.store (local.get $rec) (f64.add (f64.load (local.get $rec)) (f64.mul (f64.mul (local.get $vx) (local.get $dt)) (local.get $ground))))
          (f64.store offset=8 (local.get $rec) (f64.add (f64.load offset=8 (local.get $rec)) (f64.mul (f64.mul (local.get $vy) (local.get $dt)) (local.get $ground))))
          (call $keepInside (local.get $Q) (local.get $rec))
          (call $keepOut (local.get $Q) (local.get $rec))
          ;; upkeep with old age: energyUpkeep * (1 + perTick * (ticksAlive - start)) once past start
          (local.set $ticks (f64.load offset=56 (local.get $rec)))
          (local.set $upkeep (f64.load offset=80 (local.get $rec)))
          (if (f64.gt (local.get $ticks) (local.get $start))
            (then (local.set $upkeep (f64.mul (local.get $upkeep) (f64.add (f64.const 1) (f64.mul (f64.load offset=16 (local.get $P)) (f64.sub (local.get $ticks) (local.get $start))))))))
          ;; energy -= (upkeep + thrustCost * max(0, thrust) + turnCost * |turnRate| / maxTurnRate) * dt
          (f64.store offset=32 (local.get $rec)
            (f64.sub (f64.load offset=32 (local.get $rec))
              (f64.mul
                (f64.add
                  (f64.add (local.get $upkeep) (f64.mul (f64.load offset=64 (local.get $Q)) (f64.max (f64.const 0) (local.get $thrust))))
                  (f64.div (f64.mul (f64.load offset=72 (local.get $Q)) (f64.abs (local.get $turnRate))) (local.get $maxTurn)))
                (local.get $dt))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $next)))
    (local.get $bad)))

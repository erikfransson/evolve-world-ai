;; Batched Brain.forward in f32x4 SIMD.
(module
  (memory (export "mem") 1)

  ;; Appends the indices of the non-zero inputs to list, in order; returns how many. Branch-free except for skipping all-zero groups of sixteen.
  ;; Sixteen inputs at a time are tested first (an all-zero group only advances idx), then four at a time: the lane mask picks a byte shuffle from tab (16 shuffles of 16 bytes, then 16 counts) that packs their indices.
  (func $compact (param $src i32) (param $n i32) (param $list i32) (param $tab i32) (result i32)
    (local $p i32) (local $end i32) (local $cnt i32) (local $m i32) (local $m16 i32) (local $e16 i32) (local $idx v128) (local $four v128) (local $zero v128) (local $sixteen v128)
    (local.set $idx (v128.const i32x4 0 1 2 3))
    (local.set $four (v128.const i32x4 4 4 4 4))
    (local.set $zero (v128.const i32x4 0 0 0 0))
    (local.set $sixteen (v128.const i32x4 16 16 16 16))
    (local.set $p (local.get $src))
    (local.set $end (i32.add (local.get $src) (i32.shl (i32.and (local.get $n) (i32.const -4)) (i32.const 2))))
    (local.set $e16 (i32.add (local.get $src) (i32.shl (i32.and (local.get $n) (i32.const -16)) (i32.const 2))))
    (block $d16 (loop $l16
      (br_if $d16 (i32.ge_u (local.get $p) (local.get $e16)))
      (local.set $m16 (i8x16.bitmask (i8x16.narrow_i16x8_s
        (i16x8.narrow_i32x4_s (f32x4.ne (v128.load (local.get $p)) (local.get $zero)) (f32x4.ne (v128.load offset=16 (local.get $p)) (local.get $zero)))
        (i16x8.narrow_i32x4_s (f32x4.ne (v128.load offset=32 (local.get $p)) (local.get $zero)) (f32x4.ne (v128.load offset=48 (local.get $p)) (local.get $zero))))))
      (if (local.get $m16) (then
      (local.set $m (i32.and (local.get $m16) (i32.const 15)))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))
      (local.set $idx (i32x4.add (local.get $idx) (local.get $four)))
      (local.set $m (i32.and (i32.shr_u (local.get $m16) (i32.const 4)) (i32.const 15)))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))
      (local.set $idx (i32x4.add (local.get $idx) (local.get $four)))
      (local.set $m (i32.and (i32.shr_u (local.get $m16) (i32.const 8)) (i32.const 15)))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))
      (local.set $idx (i32x4.add (local.get $idx) (local.get $four)))
      (local.set $m (i32.and (i32.shr_u (local.get $m16) (i32.const 12)) (i32.const 15)))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))
      (local.set $idx (i32x4.add (local.get $idx) (local.get $four)))
      ) (else (local.set $idx (i32x4.add (local.get $idx) (local.get $sixteen)))))
      (local.set $p (i32.add (local.get $p) (i32.const 64)))
      (br $l16)))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $p) (local.get $end)))
      (local.set $m (i32x4.bitmask (f32x4.ne (v128.load (local.get $p)) (v128.const f32x4 0 0 0 0))))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))
      (local.set $idx (i32x4.add (local.get $idx) (local.get $four)))
      (local.set $p (i32.add (local.get $p) (i32.const 16)))
      (br $l)))
    (if (i32.and (local.get $n) (i32.const 3)) (then
      (local.set $m (i32.and
        (i32x4.bitmask (f32x4.ne (v128.load (local.get $p)) (v128.const f32x4 0 0 0 0)))
        (i32.sub (i32.shl (i32.const 1) (i32.and (local.get $n) (i32.const 3))) (i32.const 1))))
      (v128.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2)))
        (i8x16.swizzle (local.get $idx) (v128.load (i32.add (local.get $tab) (i32.shl (local.get $m) (i32.const 4))))))
      (local.set $cnt (i32.add (local.get $cnt) (i32.load8_u offset=256 (i32.add (local.get $tab) (local.get $m)))))))
    (local.get $cnt))

  ;; One layer: dst[0..nPad) = tanh(init + sum over list of src[i] * W[i][..]), the list holding cnt input indices, added in order; init is the bias row, or the partial sum of an earlier pass.
  ;; Without th the sums are stored as they are (the first of two passes over the first layer, see forward).
  ;; Columns go in groups of up to six vectors (24 outputs, so a 24-wide layer is one pass over the inputs) that stay in registers across the input loop.
  ;; The groups of up to four vectors also touch two lines at pf per input (pf moves 128 bytes while below pe) and return pf; see forward.
  (func $layer (param $src i32) (param $list i32) (param $cnt i32) (param $w i32) (param $init i32) (param $nPad i32) (param $dst i32) (param $pf i32) (param $pe i32) (param $th i32) (result i32)
    (local $jb i32) (local $stride i32) (local $bias i32) (local $left i32) (local $le i32) (local $lp i32) (local $i i32) (local $p i32) (local $b i32) (local $wj i32)
    (local $vs v128) (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128) (local $a4 v128) (local $a5 v128)
    (local $x v128) (local $x2 v128) (local $n v128) (local $d v128) (local $k0 v128) (local $k1 v128) (local $k2 v128) (local $k3 v128) (local $k4 v128) (local $k5 v128) (local $k6 v128) (local $k7 v128) (local $k8 v128)
    (local.set $stride (i32.shl (local.get $nPad) (i32.const 2)))
    (local.set $bias (local.get $init))
    (local.set $le (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 2))))
    (block $jd (loop $jl
      (local.set $left (i32.sub (local.get $stride) (local.get $jb)))
      (br_if $jd (i32.eqz (local.get $left)))
      (local.set $b (i32.add (local.get $bias) (local.get $jb)))
      (local.set $wj (i32.add (local.get $w) (local.get $jb)))
      (if (i32.ge_u (local.get $left) (i32.const 96))
        (then
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $a1 (v128.load offset=16 (local.get $b)))
          (local.set $a2 (v128.load offset=32 (local.get $b)))
          (local.set $a3 (v128.load offset=48 (local.get $b)))
          (local.set $a4 (v128.load offset=64 (local.get $b)))
          (local.set $a5 (v128.load offset=80 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (local.get $p)) (local.get $vs))))
            (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (v128.load offset=32 (local.get $p)) (local.get $vs))))
            (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (v128.load offset=48 (local.get $p)) (local.get $vs))))
            (local.set $a4 (f32x4.add (local.get $a4) (f32x4.mul (v128.load offset=64 (local.get $p)) (local.get $vs))))
            (local.set $a5 (f32x4.add (local.get $a5) (f32x4.mul (v128.load offset=80 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))
          (v128.store offset=16 (local.get $b) (local.get $a1))
          (v128.store offset=32 (local.get $b) (local.get $a2))
          (v128.store offset=48 (local.get $b) (local.get $a3))
          (v128.store offset=64 (local.get $b) (local.get $a4))
          (v128.store offset=80 (local.get $b) (local.get $a5)))
        (else (if (i32.eq (local.get $left) (i32.const 80))
        (then
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $a1 (v128.load offset=16 (local.get $b)))
          (local.set $a2 (v128.load offset=32 (local.get $b)))
          (local.set $a3 (v128.load offset=48 (local.get $b)))
          (local.set $a4 (v128.load offset=64 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (local.get $p)) (local.get $vs))))
            (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (v128.load offset=32 (local.get $p)) (local.get $vs))))
            (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (v128.load offset=48 (local.get $p)) (local.get $vs))))
            (local.set $a4 (f32x4.add (local.get $a4) (f32x4.mul (v128.load offset=64 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))
          (v128.store offset=16 (local.get $b) (local.get $a1))
          (v128.store offset=32 (local.get $b) (local.get $a2))
          (v128.store offset=48 (local.get $b) (local.get $a3))
          (v128.store offset=64 (local.get $b) (local.get $a4)))
        (else (if (i32.eq (local.get $left) (i32.const 64))
        (then
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $a1 (v128.load offset=16 (local.get $b)))
          (local.set $a2 (v128.load offset=32 (local.get $b)))
          (local.set $a3 (v128.load offset=48 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (local.get $p)) (local.get $vs))))
            (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (v128.load offset=32 (local.get $p)) (local.get $vs))))
            (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (v128.load offset=48 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (drop (i32.load (local.get $pf)))
            (drop (i32.load offset=64 (local.get $pf)))
            (local.set $pf (select (i32.add (local.get $pf) (i32.const 128)) (local.get $pf) (i32.lt_u (local.get $pf) (local.get $pe))))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))
          (v128.store offset=16 (local.get $b) (local.get $a1))
          (v128.store offset=32 (local.get $b) (local.get $a2))
          (v128.store offset=48 (local.get $b) (local.get $a3)))
        (else (if (i32.eq (local.get $left) (i32.const 48))
        (then
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $a1 (v128.load offset=16 (local.get $b)))
          (local.set $a2 (v128.load offset=32 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (local.get $p)) (local.get $vs))))
            (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (v128.load offset=32 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (drop (i32.load (local.get $pf)))
            (drop (i32.load offset=64 (local.get $pf)))
            (local.set $pf (select (i32.add (local.get $pf) (i32.const 128)) (local.get $pf) (i32.lt_u (local.get $pf) (local.get $pe))))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))
          (v128.store offset=16 (local.get $b) (local.get $a1))
          (v128.store offset=32 (local.get $b) (local.get $a2)))
        (else (if (i32.eq (local.get $left) (i32.const 32))
        (then
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $a1 (v128.load offset=16 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (drop (i32.load (local.get $pf)))
            (drop (i32.load offset=64 (local.get $pf)))
            (local.set $pf (select (i32.add (local.get $pf) (i32.const 128)) (local.get $pf) (i32.lt_u (local.get $pf) (local.get $pe))))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))
          (v128.store offset=16 (local.get $b) (local.get $a1)))
        (else
          (local.set $a0 (v128.load offset=0 (local.get $b)))
          (local.set $lp (local.get $list))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $lp) (local.get $le)))
            (local.set $i (i32.load (local.get $lp)))
            (local.set $vs (v128.load32_splat (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $p (i32.add (local.get $wj) (i32.mul (local.get $i) (local.get $stride))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load offset=0 (local.get $p)) (local.get $vs))))
            (local.set $lp (i32.add (local.get $lp) (i32.const 4)))
            (drop (i32.load (local.get $pf)))
            (drop (i32.load offset=64 (local.get $pf)))
            (local.set $pf (select (i32.add (local.get $pf) (i32.const 128)) (local.get $pf) (i32.lt_u (local.get $pf) (local.get $pe))))
            (br $il)))
          (local.set $b (i32.add (local.get $dst) (local.get $jb)))
          (v128.store offset=0 (local.get $b) (local.get $a0))))))))))))
      (local.set $jb (select (i32.add (local.get $jb) (i32.const 96)) (local.get $stride) (i32.ge_u (local.get $left) (i32.const 96))))
      (br $jl)))
    (if (local.get $th) (then
    ;; tanh in place over the layer, in a loop of its own (V8 does not inline a call to a $tanh function).
    ;; The constants sit in locals: V8 rebuilds a v128.const at each use inside a loop (three instructions).
    (local.set $k0 (v128.const f32x4 135135 135135 135135 135135))
    (local.set $k1 (v128.const f32x4 17325 17325 17325 17325))
    (local.set $k2 (v128.const f32x4 378 378 378 378))
    (local.set $k3 (v128.const f32x4 62370 62370 62370 62370))
    (local.set $k4 (v128.const f32x4 3150 3150 3150 3150))
    (local.set $k5 (v128.const f32x4 28 28 28 28))
    (local.set $k6 (v128.const i32x4 0x80000000 0x80000000 0x80000000 0x80000000))
    (local.set $k7 (v128.const f32x4 1 1 1 1))
    (local.set $k8 (v128.const f32x4 4.97 4.97 4.97 4.97))
    (local.set $p (local.get $dst))
    (local.set $b (i32.add (local.get $dst) (local.get $stride)))
    (loop $tl
      (local.set $x (v128.load (local.get $p)))
      (local.set $x2 (f32x4.mul (local.get $x) (local.get $x)))
      (local.set $n (f32x4.mul (local.get $x)
        (f32x4.add (local.get $k0)
          (f32x4.mul (local.get $x2) (f32x4.add (local.get $k1)
            (f32x4.mul (local.get $x2) (f32x4.add (local.get $k2) (local.get $x2))))))))
      (local.set $d (f32x4.add (local.get $k0)
        (f32x4.mul (local.get $x2) (f32x4.add (local.get $k3)
          (f32x4.mul (local.get $x2) (f32x4.add (local.get $k4)
            (f32x4.mul (local.get $x2) (local.get $k5))))))))
      ;; |x| >= 4.97 gives exactly +-1, as the JS version does. No clamps: wild quotients outside that range are replaced.
      (v128.store (local.get $p) (v128.bitselect
        (v128.or (v128.and (local.get $x) (local.get $k6)) (local.get $k7))
        (f32x4.div (local.get $n) (local.get $d))
        (f32x4.ge (f32x4.abs (local.get $x)) (local.get $k8))))
      (local.set $p (i32.add (local.get $p) (i32.const 16)))
      (br_if $tl (i32.lt_u (local.get $p) (local.get $b))))))
    (local.get $pf))

  ;; forward(desc, slots, n, scratchA, scratchB, nzList, iota, tab): creatures slots[0..n-1], each scratch buffer holds the widest padded layer.
  ;; The first layer adds only the non-zero inputs; the others use the identity index list iota. The last layer stores straight to the output.
  ;; A block is split: the first-layer rows of the first desc[4] inputs (the rays) sit at desc[5], the rest of the block (the other rows, biases, later layers) at desc[0].
  ;; The first layer then runs as two passes over the same column groups, the ray entries of the list first (partial sum stored to dst), the rest on top; the adds keep their order.
  ;; While a brain runs, its layers touch the next brain's weights in order, so the hardware prefetcher streams them in early (WASM has no prefetch).
  (func (export "forward") (param $desc i32) (param $slots i32) (param $n i32) (param $sa i32) (param $sb i32) (param $nz i32) (param $iota i32) (param $tab i32)
    (local $c i32) (local $d i32) (local $l i32) (local $layers i32) (local $nIn i32) (local $nOut i32) (local $nPad i32)
    (local $w i32) (local $src i32) (local $dst i32) (local $list i32) (local $cnt i32) (local $pf i32) (local $pe i32) (local $rf i32) (local $init i32) (local $k i32)
    (block $cd (loop $cl
      (br_if $cd (i32.ge_u (local.get $c) (local.get $n)))
      (local.set $d (i32.add (local.get $desc) (i32.shl (i32.load (i32.add (local.get $slots) (i32.shl (local.get $c) (i32.const 2)))) (i32.const 6))))
      (local.set $w (i32.load (local.get $d)))
      (local.set $src (i32.load offset=4 (local.get $d)))
      (local.set $layers (i32.sub (i32.load offset=12 (local.get $d)) (i32.const 1)))
      ;; pf ends over 128 bytes before the next block's inputs (or stays at 0 when there is none), so every touch is in bounds.
      (local.set $pf (i32.const 0))
      (local.set $pe (i32.const 0))
      (if (i32.lt_u (i32.add (local.get $c) (i32.const 1)) (local.get $n)) (then
        (local.set $pe (i32.add (local.get $desc) (i32.shl (i32.load offset=4 (i32.add (local.get $slots) (i32.shl (local.get $c) (i32.const 2)))) (i32.const 6))))
        (local.set $pf (i32.load (local.get $pe)))
        (local.set $pe (i32.sub (i32.load offset=4 (local.get $pe)) (i32.const 256)))
        (if (i32.lt_s (local.get $pe) (local.get $pf)) (then (local.set $pf (i32.const 0)) (local.set $pe (i32.const 0))))))
      (local.set $l (i32.const 0))
      (block $ld (loop $ll
        (br_if $ld (i32.ge_u (local.get $l) (local.get $layers)))
        (local.set $nIn (i32.load offset=24 (i32.add (local.get $d) (i32.shl (local.get $l) (i32.const 2)))))
        (local.set $nOut (i32.load offset=28 (i32.add (local.get $d) (i32.shl (local.get $l) (i32.const 2)))))
        (local.set $nPad (i32.and (i32.add (local.get $nOut) (i32.const 3)) (i32.const -4)))
        (local.set $dst (select (local.get $sb) (local.get $sa) (i32.and (local.get $l) (i32.const 1))))
        (if (i32.eq (i32.add (local.get $l) (i32.const 1)) (local.get $layers)) (then (local.set $dst (i32.load offset=8 (local.get $d)))))
        (local.set $rf (select (i32.const 0) (i32.load offset=16 (local.get $d)) (local.get $l)))
        (local.set $init (i32.add (local.get $w) (i32.mul (i32.sub (local.get $nIn) (local.get $rf)) (i32.shl (local.get $nPad) (i32.const 2)))))
        (if (local.get $l)
          (then (local.set $pf (call $layer (local.get $src) (local.get $iota) (local.get $nIn) (local.get $w) (local.get $init) (local.get $nPad) (local.get $dst) (local.get $pf) (local.get $pe) (i32.const 1))))
          (else
            (local.set $k (i32.const 0))
            (local.set $cnt (call $compact (local.get $src) (local.get $nIn) (local.get $nz) (local.get $tab)))
            (block $kd (loop $kl
              (br_if $kd (i32.ge_u (local.get $k) (local.get $cnt)))
              (br_if $kd (i32.ge_u (i32.load (i32.add (local.get $nz) (i32.shl (local.get $k) (i32.const 2)))) (local.get $rf)))
              (local.set $k (i32.add (local.get $k) (i32.const 1)))
              (br $kl)))
            (if (local.get $k) (then
              (local.set $pf (call $layer (local.get $src) (local.get $nz) (local.get $k) (i32.load offset=20 (local.get $d)) (local.get $init) (local.get $nPad) (local.get $dst) (local.get $pf) (local.get $pe) (i32.const 0)))
              (local.set $init (local.get $dst))))
            (local.set $pf (call $layer (local.get $src) (i32.add (local.get $nz) (i32.shl (local.get $k) (i32.const 2))) (i32.sub (local.get $cnt) (local.get $k))
              (i32.sub (local.get $w) (i32.mul (local.get $rf) (i32.shl (local.get $nPad) (i32.const 2)))) (local.get $init) (local.get $nPad) (local.get $dst) (local.get $pf) (local.get $pe) (i32.const 1)))))
        (local.set $w (i32.add (local.get $w) (i32.shl (i32.mul (i32.add (i32.sub (local.get $nIn) (local.get $rf)) (i32.const 1)) (local.get $nPad)) (i32.const 2))))
        (local.set $src (local.get $dst))
        (local.set $l (i32.add (local.get $l) (i32.const 1)))
        (br $ll)))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br $cl))))
)

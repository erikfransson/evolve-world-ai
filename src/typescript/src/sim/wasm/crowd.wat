;; The crowd grid from resident rows (twin of Crowd.rebuildRows and rebuildFrom in crowd.ts, which stay the reference and the fallback): the cell key of each creature,
;; a stable LSD radix sort of the creature indices by key, then the arrays sorted by cell (x, y, energy, species, owner), cellStart and the occupied cells, read
;; straight from the rows. Same arithmetic, same order, so the arrays equal the JS ones bit for bit. Offsets are layout.ts's (double-brace tokens).
;; Keep this and crowd.ts in step: tests/typescript/wasmCrowd.test.ts compares them.
;; Memory is the brain bank's (imported).
(module
  (import "brain" "mem" (memory 1))
  (import "math" "exp" (func $exp (param f64) (result f64)))

  (func (export "rebuild") (param $C i32)
    (local $n i32) (local $i i32) (local $k i32) (local $g i32) (local $rowAt i32) (local $row i32) (local $cellOf i32) (local $from i32) (local $to i32) (local $swap i32)
    (local $cols i32) (local $cell f64) (local $maxX f64) (local $maxY f64) (local $cx f64) (local $cy f64)
    (local $bits i32) (local $mask i32) (local $passes i32) (local $pass i32) (local $shift i32) (local $count i32) (local $b i32) (local $sum i32) (local $c i32) (local $j i32) (local $slot i32)
    (local $prev i32) (local $m i32) (local $start i32) (local $occupied i32) (local $species i32) (local $sp i32)
    (local.set $n (i32.load offset={{C_N}} (local.get $C)))
    (local.set $rowAt (i32.load offset={{C_ROW_AT}} (local.get $C)))
    (local.set $cellOf (i32.load offset={{C_CELL_OF}} (local.get $C)))
    (local.set $cols (i32.load offset={{C_COLS}} (local.get $C)))
    (local.set $cell (f64.load offset={{C_CELL}} (local.get $C)))
    (local.set $maxX (f64.convert_i32_s (i32.sub (local.get $cols) (i32.const 1))))
    (local.set $maxY (f64.convert_i32_s (i32.sub (i32.load offset={{C_ROWS}} (local.get $C)) (i32.const 1))))
    ;; cell key of each creature: clamped column and row; a NaN stays NaN and becomes 0 in the key, like the Int32Array store in JS
    (block $keysDone (loop $keyLoop
      (br_if $keysDone (i32.ge_s (local.get $i) (local.get $n)))
      (local.set $row (i32.shl (i32.load (i32.add (local.get $rowAt) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 3)))
      (local.set $cx (f64.floor (f64.div (f64.load offset={{R_X}} (local.get $row)) (local.get $cell))))
      (local.set $cy (f64.floor (f64.div (f64.load offset={{R_Y}} (local.get $row)) (local.get $cell))))
      (local.set $cx (select (f64.const 0) (select (local.get $maxX) (local.get $cx) (f64.gt (local.get $cx) (local.get $maxX))) (f64.lt (local.get $cx) (f64.const 0))))
      (local.set $cy (select (f64.const 0) (select (local.get $maxY) (local.get $cy) (f64.gt (local.get $cy) (local.get $maxY))) (f64.lt (local.get $cy) (f64.const 0))))
      (i32.store (i32.add (local.get $cellOf) (i32.shl (local.get $i) (i32.const 2)))
        (i32.trunc_sat_f64_s (f64.add (f64.mul (local.get $cy) (f64.convert_i32_s (local.get $cols))) (local.get $cx))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $keyLoop)))
    ;; stable LSD radix sort of the creature indices by key: to starts as the identity, each pass reads from and writes to the other buffer
    (local.set $bits (i32.load offset={{C_RADIX_BITS}} (local.get $C)))
    (local.set $mask (i32.sub (i32.shl (i32.const 1) (local.get $bits)) (i32.const 1)))
    (local.set $passes (i32.load offset={{C_RADIX_PASSES}} (local.get $C)))
    (local.set $count (i32.load offset={{C_COUNT}} (local.get $C)))
    (local.set $from (i32.load offset={{C_PERM_B}} (local.get $C)))
    (local.set $to (i32.load offset={{C_PERM}} (local.get $C)))
    (local.set $i (i32.const 0))
    (block $idDone (loop $idLoop
      (br_if $idDone (i32.ge_s (local.get $i) (local.get $n)))
      (i32.store (i32.add (local.get $to) (i32.shl (local.get $i) (i32.const 2))) (local.get $i))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $idLoop)))
    (block $passesDone (loop $passLoop
      (br_if $passesDone (i32.ge_s (local.get $pass) (local.get $passes)))
      (local.set $shift (i32.mul (local.get $pass) (local.get $bits)))
      (local.set $swap (local.get $from))
      (local.set $from (local.get $to))
      (local.set $to (local.get $swap))
      (memory.fill (local.get $count) (i32.const 0) (i32.shl (i32.add (local.get $mask) (i32.const 1)) (i32.const 2)))
      (local.set $i (i32.const 0))
      (block $histDone (loop $histLoop
        (br_if $histDone (i32.ge_s (local.get $i) (local.get $n)))
        (local.set $slot (i32.add (local.get $count) (i32.shl
          (i32.and (i32.shr_s (i32.load (i32.add (local.get $cellOf) (i32.shl (i32.load (i32.add (local.get $from) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 2)))) (local.get $shift)) (local.get $mask))
          (i32.const 2))))
        (i32.store (local.get $slot) (i32.add (i32.load (local.get $slot)) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $histLoop)))
      (local.set $sum (i32.const 0))
      (local.set $b (i32.const 0))
      (block $prefixDone (loop $prefixLoop
        (br_if $prefixDone (i32.gt_s (local.get $b) (local.get $mask)))
        (local.set $slot (i32.add (local.get $count) (i32.shl (local.get $b) (i32.const 2))))
        (local.set $c (i32.load (local.get $slot)))
        (i32.store (local.get $slot) (local.get $sum))
        (local.set $sum (i32.add (local.get $sum) (local.get $c)))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br $prefixLoop)))
      (local.set $i (i32.const 0))
      (block $scatterDone (loop $scatterLoop
        (br_if $scatterDone (i32.ge_s (local.get $i) (local.get $n)))
        (local.set $j (i32.load (i32.add (local.get $from) (i32.shl (local.get $i) (i32.const 2)))))
        (local.set $slot (i32.add (local.get $count) (i32.shl
          (i32.and (i32.shr_s (i32.load (i32.add (local.get $cellOf) (i32.shl (local.get $j) (i32.const 2)))) (local.get $shift)) (local.get $mask))
          (i32.const 2))))
        (i32.store (i32.add (local.get $to) (i32.shl (i32.load (local.get $slot)) (i32.const 2))) (local.get $j))
        (i32.store (local.get $slot) (i32.add (i32.load (local.get $slot)) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scatterLoop)))
      (local.set $pass (i32.add (local.get $pass) (i32.const 1)))
      (br $passLoop)))
    ;; the arrays sorted by cell, cellStart[c] = creatures in cells below c (written by the gaps between occupied cells) and the occupied cells
    (local.set $start (i32.load offset={{C_CELL_START}} (local.get $C)))
    (local.set $occupied (i32.load offset={{C_OCCUPIED}} (local.get $C)))
    (local.set $species (i32.load offset={{C_SPECIES_IN}} (local.get $C)))
    (local.set $prev (i32.const -1))
    (local.set $k (i32.const 0))
    (block $sortedDone (loop $sortedLoop
      (br_if $sortedDone (i32.ge_s (local.get $k) (local.get $n)))
      (local.set $i (i32.load (i32.add (local.get $to) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $row (i32.shl (i32.load (i32.add (local.get $rowAt) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 3)))
      (f64.store (i32.add (i32.load offset={{C_XS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))) (f64.load offset={{R_X}} (local.get $row)))
      (f64.store (i32.add (i32.load offset={{C_YS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))) (f64.load offset={{R_Y}} (local.get $row)))
      (f64.store (i32.add (i32.load offset={{C_ENERGIES}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))) (f64.load offset={{R_ENERGY}} (local.get $row)))
      (i32.store (i32.add (i32.load offset={{C_SPECIES}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2)))
        (select (i32.load (i32.add (local.get $species) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 0) (local.get $species)))
      (i32.store (i32.add (i32.load offset={{C_OWNERS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2))) (local.get $i))
      (local.set $c (i32.load (i32.add (local.get $cellOf) (i32.shl (local.get $i) (i32.const 2)))))
      (if (i32.ne (local.get $c) (local.get $prev))
        (then
          (local.set $g (i32.add (local.get $prev) (i32.const 1)))
          (block $gapDone (loop $gapLoop
            (br_if $gapDone (i32.gt_s (local.get $g) (local.get $c)))
            (i32.store (i32.add (local.get $start) (i32.shl (local.get $g) (i32.const 2))) (local.get $k))
            (local.set $g (i32.add (local.get $g) (i32.const 1)))
            (br $gapLoop)))
          (i32.store (i32.add (local.get $occupied) (i32.shl (local.get $m) (i32.const 2))) (local.get $c))
          (local.set $m (i32.add (local.get $m) (i32.const 1)))
          (local.set $prev (local.get $c))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $sortedLoop)))
    ;; the cells after the last occupied one start at n
    (local.set $g (i32.add (local.get $prev) (i32.const 1)))
    (block $tailDone (loop $tailLoop
      (br_if $tailDone (i32.gt_s (local.get $g) (i32.mul (local.get $cols) (i32.load offset={{C_ROWS}} (local.get $C)))))
      (i32.store (i32.add (local.get $start) (i32.shl (local.get $g) (i32.const 2))) (local.get $n))
      (local.set $g (i32.add (local.get $g) (i32.const 1)))
      (br $tailLoop)))
    (i32.store offset={{C_OCCUPIED_COUNT}} (local.get $C) (local.get $m))
  )

  ;; For the sense kernel: the sorted positions as f32 and each creature's energy signal, 1 - exp(-energy / startEnergy) as f32 (energySignal in sensors.ts), with the engine's own exp.
  (func (export "pack") (param $C i32)
    (local $k i32) (local $n i32) (local $start f64)
    (local.set $n (i32.load offset={{C_N}} (local.get $C)))
    (local.set $start (f64.load offset={{C_START_ENERGY}} (local.get $C)))
    (block $done (loop $each
      (br_if $done (i32.ge_s (local.get $k) (local.get $n)))
      (f32.store (i32.add (i32.load offset={{C_SX}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2)))
        (f32.demote_f64 (f64.load (i32.add (i32.load offset={{C_XS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))))))
      (f32.store (i32.add (i32.load offset={{C_SY}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2)))
        (f32.demote_f64 (f64.load (i32.add (i32.load offset={{C_YS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))))))
      (f32.store (i32.add (i32.load offset={{C_SIG}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2)))
        (f32.demote_f64 (f64.sub (f64.const 1)
          (call $exp (f64.div (f64.neg (f64.load (i32.add (i32.load offset={{C_ENERGIES}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))))) (local.get $start))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $each)))
  )

  ;; The index of the first item within reach of (x, y) in the item grid walk (cells row by row, each list in order), or -1 (World.firstItemWithin). The items are the
  ;; packed rows of the sense kernel, in that same walk order, with f32 positions. A NaN position has an empty cell range and finds nothing, like in JS.
  (func $firstItem (param $C i32) (param $x f64) (param $y f64) (result i32)
    (local $reach f64) (local $reach2 f64) (local $inv f64) (local $cx0 f64) (local $cx1 f64) (local $cy0 f64) (local $cy1 f64)
    (local $cols i32) (local $cy i32) (local $cyLast i32) (local $cxFirst i32) (local $cxLast i32) (local $rowAt i32) (local $p i32) (local $end i32) (local $fx f64) (local $fy f64) (local $at i32)
    (local.set $reach (f64.load offset={{C_ITEM_REACH}} (local.get $C)))
    (local.set $reach2 (f64.mul (local.get $reach) (local.get $reach)))
    (local.set $inv (f64.load offset={{C_INV_ITEM_CELL}} (local.get $C)))
    (local.set $cols (i32.load offset={{C_ITEM_COLS}} (local.get $C)))
    (local.set $cx0 (f64.max (f64.const 0) (f64.floor (f64.mul (f64.sub (local.get $x) (local.get $reach)) (local.get $inv)))))
    (local.set $cx1 (f64.min (f64.convert_i32_s (i32.sub (local.get $cols) (i32.const 1))) (f64.floor (f64.mul (f64.add (local.get $x) (local.get $reach)) (local.get $inv)))))
    (local.set $cy0 (f64.max (f64.const 0) (f64.floor (f64.mul (f64.sub (local.get $y) (local.get $reach)) (local.get $inv)))))
    (local.set $cy1 (f64.min (f64.convert_i32_s (i32.sub (i32.load offset={{C_ITEM_ROWS}} (local.get $C)) (i32.const 1))) (f64.floor (f64.mul (f64.add (local.get $y) (local.get $reach)) (local.get $inv)))))
    ;; an empty range (or a NaN one) finds nothing; otherwise both ranges lie inside the grid
    (if (i32.eqz (i32.and (f64.le (local.get $cx0) (local.get $cx1)) (f64.le (local.get $cy0) (local.get $cy1)))) (then (return (i32.const -1))))
    (local.set $cxFirst (i32.trunc_sat_f64_s (local.get $cx0)))
    (local.set $cxLast (i32.trunc_sat_f64_s (local.get $cx1)))
    (local.set $cy (i32.trunc_sat_f64_s (local.get $cy0)))
    (local.set $cyLast (i32.trunc_sat_f64_s (local.get $cy1)))
    (block $rowsDone (loop $rowLoop
      (br_if $rowsDone (i32.gt_s (local.get $cy) (local.get $cyLast)))
      ;; the items of the cells cxFirst .. cxLast of this grid row are one run of the packed row
      (local.set $rowAt (i32.add (i32.load offset={{C_ITEM_START}} (local.get $C)) (i32.shl (i32.mul (local.get $cy) (i32.add (local.get $cols) (i32.const 1))) (i32.const 2))))
      (local.set $p (i32.load (i32.add (local.get $rowAt) (i32.shl (local.get $cxFirst) (i32.const 2)))))
      (local.set $end (i32.load (i32.add (local.get $rowAt) (i32.shl (i32.add (local.get $cxLast) (i32.const 1)) (i32.const 2)))))
      (block $itemsDone (loop $itemLoop
        (br_if $itemsDone (i32.ge_s (local.get $p) (local.get $end)))
        (local.set $at (i32.add (i32.load offset={{C_ITEM_XY}} (local.get $C)) (i32.shl (local.get $p) (i32.const 3))))
        (local.set $fx (f64.sub (f64.promote_f32 (f32.load (local.get $at))) (local.get $x)))
        (local.set $fy (f64.sub (f64.promote_f32 (f32.load offset=4 (local.get $at))) (local.get $y)))
        (if (f64.lt (f64.add (f64.mul (local.get $fx) (local.get $fx)) (f64.mul (local.get $fy) (local.get $fy))) (local.get $reach2))
          (then (return (i32.load (i32.add (i32.load offset={{C_ITEM_IDS}} (local.get $C)) (i32.shl (local.get $p) (i32.const 2)))))))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (br $itemLoop)))
      (local.set $cy (i32.add (local.get $cy) (i32.const 1)))
      (br $rowLoop)))
    (i32.const -1)
  )

  ;; For each creature of the sorted arrays, in cell order, the item it touches into touchOut[owner] (World.touchedBatch).
  (func (export "touch") (param $C i32)
    (local $k i32) (local $n i32)
    (local.set $n (i32.load offset={{C_N}} (local.get $C)))
    (block $done (loop $each
      (br_if $done (i32.ge_s (local.get $k) (local.get $n)))
      (i32.store
        (i32.add (i32.load offset={{C_TOUCH_OUT}} (local.get $C)) (i32.shl (i32.load (i32.add (i32.load offset={{C_OWNERS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 2)))
        (call $firstItem (local.get $C)
          (f64.load (i32.add (i32.load offset={{C_XS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))))
          (f64.load (i32.add (i32.load offset={{C_YS}} (local.get $C)) (i32.shl (local.get $k) (i32.const 3))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $each)))
  )

  ;; The next pair of the collision sweep (Ecosystem.collideAll): occupied cells in order, for each creature s of a cell first the later creatures of its cell and the cell to
  ;; the right (one run), then the three cells below (another), a pair when the squared distance is not at least reach2 (a NaN one is). Returns 1 with the pair in C_HIT_S and
  ;; C_HIT_T, or 0 at the end. The caller bumps the pair, writing the new positions into the arrays, and calls again to go on after it. C_SW_RESUME 0 starts at the first cell.
  (func (export "sweep") (param $C i32) (result i32)
    (local $o i32) (local $c i32) (local $cy i32) (local $cx i32) (local $cols i32) (local $rows i32) (local $end i32) (local $hasRight i32) (local $run1 i32) (local $run2a i32) (local $run2b i32)
    (local $s i32) (local $t i32) (local $phase i32) (local $resume i32) (local $below i32) (local $start i32) (local $xs i32) (local $ys i32) (local $reach2 f64) (local $dx f64) (local $dy f64)
    (local.set $cols (i32.load offset={{C_COLS}} (local.get $C)))
    (local.set $rows (i32.load offset={{C_ROWS}} (local.get $C)))
    (local.set $start (i32.load offset={{C_CELL_START}} (local.get $C)))
    (local.set $xs (i32.load offset={{C_XS}} (local.get $C)))
    (local.set $ys (i32.load offset={{C_YS}} (local.get $C)))
    (local.set $reach2 (f64.load offset={{C_REACH2}} (local.get $C)))
    (local.set $resume (i32.load offset={{C_SW_RESUME}} (local.get $C)))
    (local.set $o (i32.load offset={{C_SW_O}} (local.get $C)))
    (local.set $s (i32.load offset={{C_SW_S}} (local.get $C)))
    (local.set $phase (i32.load offset={{C_SW_PHASE}} (local.get $C)))
    (local.set $t (i32.load offset={{C_SW_T}} (local.get $C)))
    (block $cellsDone (loop $cellLoop
      (br_if $cellsDone (i32.ge_s (local.get $o) (i32.load offset={{C_OCCUPIED_COUNT}} (local.get $C))))
      (local.set $c (i32.load (i32.add (i32.load offset={{C_OCCUPIED}} (local.get $C)) (i32.shl (local.get $o) (i32.const 2)))))
      (local.set $cy (i32.div_u (local.get $c) (local.get $cols)))
      (local.set $cx (i32.sub (local.get $c) (i32.mul (local.get $cy) (local.get $cols))))
      (local.set $end (i32.load (i32.add (local.get $start) (i32.shl (i32.add (local.get $c) (i32.const 1)) (i32.const 2)))))
      (local.set $hasRight (i32.lt_s (i32.add (local.get $cx) (i32.const 1)) (local.get $cols)))
      ;; the run of the later creatures of this cell and the cell to the right, and the run of the cells below-left, below and below-right
      (local.set $run1 (select (i32.load (i32.add (local.get $start) (i32.shl (i32.add (local.get $c) (i32.const 2)) (i32.const 2)))) (local.get $end) (local.get $hasRight)))
      (local.set $run2a (i32.const 0))
      (local.set $run2b (i32.const 0))
      (if (i32.lt_s (i32.add (local.get $cy) (i32.const 1)) (local.get $rows))
        (then
          (local.set $below (i32.add (local.get $c) (local.get $cols)))
          (local.set $run2a (i32.load (i32.add (local.get $start) (i32.shl (select (i32.sub (local.get $below) (i32.const 1)) (local.get $below) (i32.gt_s (local.get $cx) (i32.const 0))) (i32.const 2)))))
          (local.set $run2b (i32.load (i32.add (local.get $start) (i32.shl (select (i32.add (local.get $below) (i32.const 2)) (i32.add (local.get $below) (i32.const 1)) (local.get $hasRight)) (i32.const 2)))))))
      (if (i32.eqz (local.get $resume)) (then (local.set $s (i32.load (i32.add (local.get $start) (i32.shl (local.get $c) (i32.const 2)))))))
      (block $creaturesDone (loop $creatureLoop
        (br_if $creaturesDone (i32.ge_s (local.get $s) (local.get $end)))
        (if (i32.eqz (local.get $resume)) (then (local.set $phase (i32.const 0)) (local.set $t (i32.add (local.get $s) (i32.const 1)))))
        (local.set $resume (i32.const 0))
        (if (i32.eqz (local.get $phase))
          (then
            (block $run1Done (loop $run1Loop
              (br_if $run1Done (i32.ge_s (local.get $t) (local.get $run1)))
              (local.set $dx (f64.sub (f64.load (i32.add (local.get $xs) (i32.shl (local.get $t) (i32.const 3)))) (f64.load (i32.add (local.get $xs) (i32.shl (local.get $s) (i32.const 3))))))
              (local.set $dy (f64.sub (f64.load (i32.add (local.get $ys) (i32.shl (local.get $t) (i32.const 3)))) (f64.load (i32.add (local.get $ys) (i32.shl (local.get $s) (i32.const 3))))))
              (if (i32.eqz (f64.ge (f64.add (f64.mul (local.get $dx) (local.get $dx)) (f64.mul (local.get $dy) (local.get $dy))) (local.get $reach2)))
                (then (call $found (local.get $C) (local.get $o) (local.get $s) (i32.const 0) (local.get $t)) (return (i32.const 1))))
              (local.set $t (i32.add (local.get $t) (i32.const 1)))
              (br $run1Loop)))
            (local.set $phase (i32.const 1))
            (local.set $t (local.get $run2a))))
        (block $run2Done (loop $run2Loop
          (br_if $run2Done (i32.ge_s (local.get $t) (local.get $run2b)))
          (local.set $dx (f64.sub (f64.load (i32.add (local.get $xs) (i32.shl (local.get $t) (i32.const 3)))) (f64.load (i32.add (local.get $xs) (i32.shl (local.get $s) (i32.const 3))))))
          (local.set $dy (f64.sub (f64.load (i32.add (local.get $ys) (i32.shl (local.get $t) (i32.const 3)))) (f64.load (i32.add (local.get $ys) (i32.shl (local.get $s) (i32.const 3))))))
          (if (i32.eqz (f64.ge (f64.add (f64.mul (local.get $dx) (local.get $dx)) (f64.mul (local.get $dy) (local.get $dy))) (local.get $reach2)))
            (then (call $found (local.get $C) (local.get $o) (local.get $s) (i32.const 1) (local.get $t)) (return (i32.const 1))))
          (local.set $t (i32.add (local.get $t) (i32.const 1)))
          (br $run2Loop)))
        (local.set $s (i32.add (local.get $s) (i32.const 1)))
        (br $creatureLoop)))
      (local.set $o (i32.add (local.get $o) (i32.const 1)))
      (br $cellLoop)))
    (i32.const 0)
  )

  ;; Records the pair (s, t) found in phase (run) of cell o as the result and as the place to go on from, just after t.
  (func $found (param $C i32) (param $o i32) (param $s i32) (param $phase i32) (param $t i32)
    (i32.store offset={{C_HIT_S}} (local.get $C) (local.get $s))
    (i32.store offset={{C_HIT_T}} (local.get $C) (local.get $t))
    (i32.store offset={{C_SW_O}} (local.get $C) (local.get $o))
    (i32.store offset={{C_SW_S}} (local.get $C) (local.get $s))
    (i32.store offset={{C_SW_PHASE}} (local.get $C) (local.get $phase))
    (i32.store offset={{C_SW_T}} (local.get $C) (i32.add (local.get $t) (i32.const 1)))
    (i32.store offset={{C_SW_RESUME}} (local.get $C) (i32.const 1))
  )
)

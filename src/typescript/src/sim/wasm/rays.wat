;; Batched Crowd.castRays in f32x4 SIMD: rays of many creatures against the crowd's cell-sorted arrays.
;; Creature record, 32 bytes: x f32, y f32, length f32, self owner i32, ray count i32, first ray index i32 (multiple of 4), 8 unused.
;; Rays are padded to a multiple of 4 with zero directions (never hit). best is in/out (distance), hit is the sorted crowd slot or -1.
;; Same wedge cull and ray-circle test as the JS version; cand is scratch of 16 bytes per crowd slot.
(module
  (memory (export "mem") 1)

  (func (export "cast") (param $n i32) (param $cols i32) (param $rows i32) (param $inv f32) (param $r f32)
        (param $start i32) (param $sx i32) (param $sy i32) (param $own i32)
        (param $rec i32) (param $dX i32) (param $dY i32) (param $best i32) (param $hit i32) (param $cand i32)
    (local $j i32) (local $q i32) (local $x f32) (local $y f32) (local $L f32) (local $self i32) (local $nR i32) (local $at i32)
    (local $far f32) (local $far2 f32) (local $margin f32) (local $r2 f32) (local $wedge i32) (local $last i32)
    (local $d0x f32) (local $d0y f32) (local $d1x f32) (local $d1y f32)
    (local $cx0 i32) (local $cx1 i32) (local $cy0 i32) (local $cy1 i32) (local $cy i32) (local $row i32)
    (local $k i32) (local $e i32) (local $fx f32) (local $fy f32) (local $d2 f32) (local $cp i32) (local $ce i32)
    (local $g i32) (local $ro i32) (local $dx v128) (local $dy v128) (local $bs v128) (local $ix v128)
    (local $b v128) (local $c v128) (local $disc v128) (local $t v128) (local $inside v128) (local $m v128)
    (local.set $r2 (f32.mul (local.get $r) (local.get $r)))
    (block $jd (loop $jl
      (br_if $jd (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $q (i32.add (local.get $rec) (i32.shl (local.get $j) (i32.const 5))))
      (local.set $x (f32.load (local.get $q)))
      (local.set $y (f32.load offset=4 (local.get $q)))
      (local.set $L (f32.load offset=8 (local.get $q)))
      (local.set $self (i32.load offset=12 (local.get $q)))
      (local.set $nR (i32.load offset=16 (local.get $q)))
      (local.set $at (i32.load offset=20 (local.get $q)))
      (local.set $far (f32.add (f32.add (local.get $L) (local.get $r)) (f32.mul (local.get $L) (f32.const 1e-9))))
      (local.set $far2 (f32.mul (local.get $far) (local.get $far)))
      (local.set $margin (f32.add (local.get $r) (f32.mul (local.get $L) (f32.const 1e-9))))
      (local.set $last (i32.sub (i32.add (local.get $at) (local.get $nR)) (i32.const 1)))
      (local.set $d0x (f32.load (i32.add (local.get $dX) (i32.shl (local.get $at) (i32.const 2)))))
      (local.set $d0y (f32.load (i32.add (local.get $dY) (i32.shl (local.get $at) (i32.const 2)))))
      (local.set $d1x (f32.load (i32.add (local.get $dX) (i32.shl (local.get $last) (i32.const 2)))))
      (local.set $d1y (f32.load (i32.add (local.get $dY) (i32.shl (local.get $last) (i32.const 2)))))
      (local.set $wedge (i32.and (i32.gt_s (local.get $nR) (i32.const 1))
        (f32.gt (f32.sub (f32.mul (local.get $d0x) (local.get $d1y)) (f32.mul (local.get $d0y) (local.get $d1x))) (f32.const 1e-9))))
      ;; cell window, clamped to the grid
      (local.set $cx0 (i32.trunc_sat_f32_s (f32.floor (f32.mul (f32.sub (local.get $x) (local.get $far)) (local.get $inv)))))
      (local.set $cx0 (select (i32.const 0) (local.get $cx0) (i32.lt_s (local.get $cx0) (i32.const 0))))
      (local.set $cx1 (i32.trunc_sat_f32_s (f32.floor (f32.mul (f32.add (local.get $x) (local.get $far)) (local.get $inv)))))
      (local.set $cx1 (select (i32.sub (local.get $cols) (i32.const 1)) (local.get $cx1) (i32.ge_s (local.get $cx1) (local.get $cols))))
      (local.set $cy0 (i32.trunc_sat_f32_s (f32.floor (f32.mul (f32.sub (local.get $y) (local.get $far)) (local.get $inv)))))
      (local.set $cy0 (select (i32.const 0) (local.get $cy0) (i32.lt_s (local.get $cy0) (i32.const 0))))
      (local.set $cy1 (i32.trunc_sat_f32_s (f32.floor (f32.mul (f32.add (local.get $y) (local.get $far)) (local.get $inv)))))
      (local.set $cy1 (select (i32.sub (local.get $rows) (i32.const 1)) (local.get $cy1) (i32.ge_s (local.get $cy1) (local.get $rows))))
      ;; gather candidates: fx, fy, d2 - r2, slot
      (local.set $cp (local.get $cand))
      (local.set $cy (local.get $cy0))
      (block $cyd (loop $cyl
        (br_if $cyd (i32.gt_s (local.get $cy) (local.get $cy1)))
        (local.set $row (i32.mul (local.get $cy) (local.get $cols)))
        (local.set $k (i32.load (i32.add (local.get $start) (i32.shl (i32.add (local.get $row) (local.get $cx0)) (i32.const 2)))))
        (local.set $e (i32.load (i32.add (local.get $start) (i32.shl (i32.add (i32.add (local.get $row) (local.get $cx1)) (i32.const 1)) (i32.const 2)))))
        (block $kd (loop $kl
          (br_if $kd (i32.ge_s (local.get $k) (local.get $e)))
          (if (i32.ne (i32.load (i32.add (local.get $own) (i32.shl (local.get $k) (i32.const 2)))) (local.get $self)) (then
            (local.set $fx (f32.sub (f32.load (i32.add (local.get $sx) (i32.shl (local.get $k) (i32.const 2)))) (local.get $x)))
            (local.set $fy (f32.sub (f32.load (i32.add (local.get $sy) (i32.shl (local.get $k) (i32.const 2)))) (local.get $y)))
            (local.set $d2 (f32.add (f32.mul (local.get $fx) (local.get $fx)) (f32.mul (local.get $fy) (local.get $fy))))
            (if (i32.and (f32.le (local.get $d2) (local.get $far2))
                  (i32.or (i32.eqz (local.get $wedge))
                    (i32.and
                      (f32.ge (f32.sub (f32.mul (local.get $d0x) (local.get $fy)) (f32.mul (local.get $d0y) (local.get $fx))) (f32.neg (local.get $margin)))
                      (f32.le (f32.sub (f32.mul (local.get $d1x) (local.get $fy)) (f32.mul (local.get $d1y) (local.get $fx))) (local.get $margin)))))
              (then
                (f32.store (local.get $cp) (local.get $fx))
                (f32.store offset=4 (local.get $cp) (local.get $fy))
                (f32.store offset=8 (local.get $cp) (f32.sub (local.get $d2) (local.get $r2)))
                (i32.store offset=12 (local.get $cp) (local.get $k))
                (local.set $cp (i32.add (local.get $cp) (i32.const 16)))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $kl)))
        (local.set $cy (i32.add (local.get $cy) (i32.const 1)))
        (br $cyl)))
      (local.set $ce (local.get $cp))
      ;; four rays at a time against every candidate
      (local.set $g (i32.const 0))
      (block $gd (loop $gl
        (br_if $gd (i32.ge_s (i32.shl (local.get $g) (i32.const 2)) (local.get $nR)))
        (local.set $ro (i32.shl (i32.add (local.get $at) (i32.shl (local.get $g) (i32.const 2))) (i32.const 2)))
        (local.set $dx (v128.load (i32.add (local.get $dX) (local.get $ro))))
        (local.set $dy (v128.load (i32.add (local.get $dY) (local.get $ro))))
        (local.set $bs (v128.load (i32.add (local.get $best) (local.get $ro))))
        (local.set $ix (v128.const i32x4 -1 -1 -1 -1))
        (local.set $cp (local.get $cand))
        (block $cd (loop $cl
          (br_if $cd (i32.ge_u (local.get $cp) (local.get $ce)))
          (local.set $b (f32x4.add (f32x4.mul (v128.load32_splat (local.get $cp)) (local.get $dx))
                                   (f32x4.mul (v128.load32_splat offset=4 (local.get $cp)) (local.get $dy))))
          (local.set $c (v128.load32_splat offset=8 (local.get $cp)))
          (local.set $disc (f32x4.sub (f32x4.mul (local.get $b) (local.get $b)) (local.get $c)))
          (local.set $t (f32x4.sub (local.get $b) (f32x4.sqrt (f32x4.max (local.get $disc) (v128.const f32x4 0 0 0 0)))))
          (local.set $inside (f32x4.lt (local.get $c) (v128.const f32x4 0 0 0 0)))
          (local.set $t (v128.andnot (local.get $t) (local.get $inside)))
          (local.set $m (v128.and
            (v128.or (local.get $inside) (v128.and (f32x4.gt (local.get $b) (v128.const f32x4 0 0 0 0)) (f32x4.ge (local.get $disc) (v128.const f32x4 0 0 0 0))))
            (f32x4.lt (local.get $t) (local.get $bs))))
          (local.set $bs (v128.bitselect (local.get $t) (local.get $bs) (local.get $m)))
          (local.set $ix (v128.bitselect (v128.load32_splat offset=12 (local.get $cp)) (local.get $ix) (local.get $m)))
          (local.set $cp (i32.add (local.get $cp) (i32.const 16)))
          (br $cl)))
        (v128.store (i32.add (local.get $best) (local.get $ro)) (local.get $bs))
        (v128.store (i32.add (local.get $hit) (local.get $ro)) (local.get $ix))
        (local.set $g (i32.add (local.get $g) (i32.const 1)))
        (br $gl)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $jl))))
)
